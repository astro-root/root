# Firebase config — copy this file to `.env` and fill in real values.
# These come from: Firebase Console → Project settings → General → "Your apps" → SDK setup and configuration.
# They are safe to expose to the browser (that's what PUBLIC_ means to Astro) —
# Firebase projects are protected by Firestore Security Rules, not by hiding this config.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# The Firebase Auth UID of the one account allowed to use /admin.
# Firebase Console → Authentication → Users → (your user) → copy the "User UID" column.
# This value is also pasted into firestore.rules — the two must match.
PUBLIC_ADMIN_UID=
