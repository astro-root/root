---
interface Props {
  /** 'full' for the Hero, 'quiet' for secondary page headers. */
  variant?: 'full' | 'quiet';
}
const { variant = 'quiet' } = Astro.props;

// Fixed, hand-placed points — deliberately sparse, not a starfield.
const stars = [
  { x: 8, y: 14, r: 1.2, o: 0.5 },
  { x: 22, y: 6, r: 0.8, o: 0.35 },
  { x: 41, y: 22, r: 1, o: 0.4 },
  { x: 67, y: 9, r: 1.4, o: 0.55 },
  { x: 78, y: 28, r: 0.8, o: 0.3 },
  { x: 91, y: 16, r: 1, o: 0.4 },
  { x: 13, y: 38, r: 0.8, o: 0.3 },
  { x: 58, y: 40, r: 1.1, o: 0.35 },
  { x: 85, y: 46, r: 0.9, o: 0.3 },
  { x: 33, y: 48, r: 0.7, o: 0.25 }
];
---

<div class:list={['cosmic', `cosmic--${variant}`]} aria-hidden="true">
  <svg class="cosmic__grid" preserveAspectRatio="none" viewBox="0 0 100 100">
    <defs>
      <pattern id={`grid-${variant}`} width="6.25" height="6.25" patternUnits="userSpaceOnUse">
        <path d="M 6.25 0 L 0 0 0 6.25" fill="none" stroke="currentColor" stroke-width="0.06" />
      </pattern>
    </defs>
    <rect width="100" height="100" fill={`url(#grid-${variant})`} />
  </svg>

  <svg class="cosmic__orbits" preserveAspectRatio="none" viewBox="0 0 100 100">
    <ellipse cx="86" cy="28" rx="50" ry="42" />
    <ellipse cx="86" cy="28" rx="32" ry="27" />
  </svg>

  <svg class="cosmic__stars" preserveAspectRatio="none" viewBox="0 0 100 100">
    {stars.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r * 0.18} fill="currentColor" opacity={s.o} />
    ))}
  </svg>
</div>

<style>
  .cosmic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--color-ink-soft);
    z-index: 0;
  }

  .cosmic svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cosmic__grid {
    opacity: 0.08;
  }

  .cosmic__orbits {
    opacity: 0.16;
    color: var(--color-accent);
  }

  .cosmic__orbits ellipse {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.15;
  }

  .cosmic__stars {
    opacity: 0.9;
  }

  .cosmic--quiet .cosmic__grid {
    opacity: 0.035;
  }

  .cosmic--quiet .cosmic__orbits {
    opacity: 0.06;
  }

  .cosmic--quiet .cosmic__stars {
    opacity: 0.5;
  }
</style>
