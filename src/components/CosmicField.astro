---
// A very quiet trace of grid lines — the only nod to "observation" on this
// site. No stars, no orbits, no color. Used sparingly (home page only).
interface Props {
  variant?: 'full' | 'quiet';
}
const { variant = 'quiet' } = Astro.props;
---

<div class:list={['cosmic', `cosmic--${variant}`]} aria-hidden="true">
  <svg class="cosmic__grid" preserveAspectRatio="none" viewBox="0 0 100 100">
    <defs>
      <pattern id={`grid-${variant}`} width="8.3333" height="8.3333" patternUnits="userSpaceOnUse">
        <path d="M 8.3333 0 L 0 0 0 8.3333" fill="none" stroke="currentColor" stroke-width="0.05" />
      </pattern>
    </defs>
    <rect width="100" height="100" fill={`url(#grid-${variant})`} />
  </svg>
</div>

<style>
  .cosmic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--color-ink-soft);
    z-index: 0;
  }

  .cosmic svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cosmic__grid {
    opacity: 0.035;
  }

  .cosmic--quiet .cosmic__grid {
    opacity: 0.02;
  }
</style>
