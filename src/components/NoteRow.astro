---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, category, excerpt } = post.data;
const slug = post.data.slugOverride ?? post.slug;

const formatted = date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});
---

<a class="note" href={`/blog/${slug}/`}>
  <p class="note__date">{formatted}</p>
  <div class="note__body">
    <p class="note__category">{category}</p>
    <h3 class="note__title">{title}</h3>
    <p class="note__excerpt">{excerpt}</p>
  </div>
</a>

<style>
  .note {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    border-top: 1px solid var(--color-line);
    text-decoration: none;
  }

  .note__date {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .note__category {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }

  .note__title {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    transition: color var(--dur-fast) var(--ease-lab);
  }

  .note:hover .note__title,
  .note:focus-visible .note__title {
    color: var(--color-accent);
  }

  .note__excerpt {
    margin-top: 0.6rem;
    max-width: 58ch;
    color: var(--color-ink-soft);
  }

  @media (max-width: 560px) {
    .note {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
