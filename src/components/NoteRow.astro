---
// A log line: date + title + category. Rounded hover state instead of a
// full bordered card — keeps a long list readable while still feeling
// like part of the same "modern" interaction language as the cards.
import type { Post } from '@/lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, category, slug } = post;

const formatted = new Date(date)
  .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .replace(/\//g, '.');
---

<a class="note" href={`/blog/${slug}/`}>
  <span class="note__date">{formatted}</span>
  <span class="note__title">{title}</span>
  <span class="badge note__badge">{category}</span>
</a>

<style>
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    padding: 0.85rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-lab);
  }

  .note:hover,
  .note:focus-visible {
    background: var(--color-bg-raised);
  }

  .note__date {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    width: 6rem;
    flex-shrink: 0;
  }

  .note__title {
    font-size: var(--fs-1);
    font-weight: 500;
  }

  .note__badge {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .note {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .note__badge {
      margin-left: 0;
    }
  }
</style>
