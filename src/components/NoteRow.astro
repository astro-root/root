---
// A single log line: date + title. No excerpt, no card — just a record.
import type { Post } from '@/lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, category, slug } = post;

const formatted = new Date(date)
  .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .replace(/\//g, '.');
---

<a class="note" href={`/blog/${slug}/`}>
  <span class="note__date">{formatted}</span>
  <span class="note__title">{title}</span>
  <span class="note__category">{category}</span>
</a>

<style>
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--color-line);
    text-decoration: none;
  }

  .note__date {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    width: 6rem;
    flex-shrink: 0;
  }

  .note__title {
    font-size: var(--fs-1);
    position: relative;
  }

  .note__title::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -1px;
    height: 1px;
    background: var(--color-ink);
    transition: right var(--dur-med) var(--ease-lab);
  }

  .note:hover .note__title::after,
  .note:focus-visible .note__title::after {
    right: 0;
  }

  .note__category {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  @media (max-width: 560px) {
    .note {
      flex-direction: column;
      gap: 0.25rem;
    }

    .note__category {
      margin-left: 0;
    }
  }
</style>
