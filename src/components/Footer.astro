---
import { getSettings } from '@/lib/content';
const settings = await getSettings();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__mark">ROOT'S LABORATORY</p>

    <ul class="site-footer__links">
      <li><a href={settings.githubUrl} target="_blank" rel="noreferrer">GitHub</a></li>
      <li><a href={settings.xUrl} target="_blank" rel="noreferrer">X</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>

    <p class="site-footer__copy">{settings.footerNote} {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: 2.5rem;
    margin-top: clamp(4rem, 10vw, 8rem);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .site-footer__mark {
    letter-spacing: 0.03em;
  }

  .site-footer__links {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__links a {
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }
</style>
