---
import type { Settings } from '@/lib/defaults';
interface Props { settings: Settings }
const { settings } = Astro.props;
const { site, footer, social } = settings;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <a href="/" class="brand"><img src={site.logo} alt="" width="32" height="32" /><span>{site.name}</span></a>
      <p style="margin-top:0.75rem;max-width:26rem;line-height:1.7">{site.tagline}</p>
    </div>
    <div class="site-footer__cols">
      <ul>
        {footer.links.map((l) => <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}</a></li>)}
        <li><a href="/contact">お問い合わせ</a></li>
      </ul>
      {footer.showSocial && social.length > 0 && (
        <ul>
          {social.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}
        </ul>
      )}
    </div>
    <p class="site-footer__copy">{site.copyright} {year}{footer.note ? ` · ${footer.note}` : ''}</p>
  </div>
</footer>
