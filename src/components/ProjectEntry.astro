---
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
  variant?: 'compact' | 'full';
}

const { project, variant = 'full' } = Astro.props;
const { title, summary, category, status, year, technology, url, github } = project;

const statusTone = status === 'Active' ? 'on' : status === 'Concept' ? 'muted' : 'default';
---

<article class:list={['card', `card--${variant}`]}>
  <div class="card__badges">
    <span class="badge">{category}</span>
    <span class:list={['badge', `badge--${statusTone}`]}>{status}</span>
    <span class="card__year">{year}</span>
  </div>

  <h3 class="card__title">{title}</h3>
  <p class="card__summary">{summary}</p>

  {
    variant === 'full' && technology.length > 0 && (
      <ul class="card__tech">
        {technology.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }

  {
    (url || github) && (
      <div class="card__links">
        {url && (
          <a class="btn-link" href={url} target="_blank" rel="noreferrer">
            Visit site ↗
          </a>
        )}
        {github && (
          <a class="btn-link btn-link--muted" href={github} target="_blank" rel="noreferrer">
            Source
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .card {
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color var(--dur-fast) var(--ease-lab), transform var(--dur-fast) var(--ease-lab);
  }

  .card:hover {
    border-color: var(--color-line-strong);
  }

  .card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg-raised);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
  }

  .badge--on {
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
    border-color: transparent;
  }

  .badge--muted {
    color: var(--color-muted);
  }

  .card__year {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .card__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
  }

  .card__summary {
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
    font-size: var(--fs-00);
    flex-grow: 1;
  }

  .card--compact .card__summary {
    max-width: 40ch;
  }

  .card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .card__tech li {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-ink-soft);
    background: var(--color-bg-raised);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .card__links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .btn-link {
    font-size: var(--fs-00);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .btn-link:hover {
    text-decoration: underline;
  }

  .btn-link--muted {
    color: var(--color-ink-soft);
  }
</style>
