---
// Card component for Projects — modeled after quiznavi's tournament cards:
// a bordered, rounded card with a color-coded status badge at a glance.
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { id, title, summary, category, status, year, technology } = project;

const statusClass =
  status === 'Active'
    ? 'status-active'
    : status === 'In Development'
      ? 'status-dev'
      : status === 'Concept'
        ? 'status-concept'
        : 'status-archived';
---

<a class="card" href={`/projects/${id}`}>
  <div class="card__top">
    <span class={`badge ${statusClass}`}>{status}</span>
    <span class="card__year">{year}</span>
  </div>

  <h3 class="card__title">{title}</h3>
  <p class="card__summary">{summary}</p>

  <div class="card__foot">
    <span class="card__category">{category}</span>
    {technology.length > 0 && <span class="card__tech">{technology.slice(0, 3).join(' · ')}</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    height: 100%;
    transition: transform var(--dur-fast) var(--ease-lab), border-color var(--dur-fast) var(--ease-lab),
      box-shadow var(--dur-fast) var(--ease-lab);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
    box-shadow: 0 1px 2px rgba(17, 18, 20, 0.04), 0 16px 32px -14px rgba(17, 18, 20, 0.22);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .card__title {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .card__summary {
    margin-top: 0.45rem;
    color: var(--color-ink-soft);
    font-size: var(--fs-00);
    flex-grow: 1;
  }

  .card__foot {
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .card__category {
    color: var(--color-ink-soft);
  }
</style>
