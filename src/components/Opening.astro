---
// Runs once per session on the home page. Pure CSS drives the sequence
// (so it still plays correctly with no JavaScript); a small script only
// adds the skip control and remembers that the sequence has played.
// Kept deliberately short — this draws "Root" and gets out of the way.
const letters = ['R', 'o', 'o', 't'];
---

<div class="opening" id="opening">
  <p class="opening__word" role="img" aria-label="Root">
    {
      letters.map((letter, i) => (
        <span class="opening__letter" aria-hidden="true" style={`--i:${i}`}>
          {letter}
        </span>
      ))
    }
  </p>

  <button class="opening__skip" id="opening-skip" type="button">
    Skip
  </button>
</div>

<style>
  .opening {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    animation: opening-exit 500ms var(--ease-lab) forwards;
    animation-delay: 1.5s;
  }

  .opening.is-skipping {
    animation: opening-exit 300ms var(--ease-lab) forwards !important;
    animation-delay: 0ms !important;
  }

  html.no-opening .opening {
    display: none;
  }

  .opening__word {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(3rem, 14vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .opening__letter {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--color-ink);
    opacity: 0;
    transform: translateY(0.15em);
    animation: letter-draw 550ms var(--ease-lab) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }

  .opening__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    opacity: 0;
    animation: rise-in 400ms var(--ease-lab) forwards;
    animation-delay: 0.4s;
  }

  .opening__skip:hover,
  .opening__skip:focus-visible {
    color: var(--color-ink);
  }

  @keyframes letter-draw {
    0% {
      opacity: 0;
      transform: translateY(0.15em);
      color: transparent;
      -webkit-text-stroke: 1.2px var(--color-ink);
    }
    40% {
      opacity: 1;
      transform: translateY(0);
      color: transparent;
      -webkit-text-stroke: 1.2px var(--color-ink);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      color: var(--color-ink);
      -webkit-text-stroke: 0px transparent;
    }
  }

  @keyframes rise-in {
    to {
      opacity: 1;
    }
  }

  @keyframes opening-exit {
    0%,
    80% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening {
      animation-delay: 0.3s;
    }
  }
</style>

<script>
  const opening = document.getElementById('opening');
  const skip = document.getElementById('opening-skip');

  const finish = () => {
    try {
      sessionStorage.setItem('rl-opening-seen', '1');
    } catch {
      /* private mode / storage unavailable — safe to ignore */
    }
  };

  skip?.addEventListener('click', () => {
    opening?.classList.add('is-skipping');
    finish();
  });

  opening?.addEventListener('animationend', (e) => {
    if (e.target === opening) finish();
  });
</script>
