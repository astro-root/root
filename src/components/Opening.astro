---
// Runs once per session on the home page. Pure CSS drives the sequence
// (so it still plays correctly with no JavaScript); a small script only
// adds the skip control and remembers that the sequence has played.
const letters = ['R', 'o', 'o', 't'];
---

<div class="opening" id="opening">
  <div
    class="opening__stage"
    role="img"
    aria-label="Root's Laboratory. Science. Software. Ideas."
  >
    <p class="opening__word" aria-hidden="true">
      {
        letters.map((letter, i) => (
          <span class="opening__letter" style={`--i:${i}`}>
            {letter}
          </span>
        ))
      }
    </p>
    <p class="opening__brand" aria-hidden="true">ROOT'S LABORATORY</p>
    <p class="opening__tagline" aria-hidden="true">Science. Software. Ideas.</p>
  </div>

  <button class="opening__skip" id="opening-skip" type="button">
    Skip intro
  </button>
</div>

<style>
  .opening {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    background: var(--color-bg);
    animation: opening-exit 900ms var(--ease-lab) forwards;
    animation-delay: 3.3s;
  }

  .opening.is-skipping {
    animation: opening-exit 500ms var(--ease-lab) forwards !important;
    animation-delay: 0ms !important;
  }

  html.no-opening .opening {
    display: none;
  }

  .opening__stage {
    text-align: center;
  }

  .opening__word {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(3.5rem, 16vw, 9rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .opening__letter {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-accent);
    opacity: 0;
    transform: translateY(0.2em);
    animation: letter-draw 900ms var(--ease-lab) forwards;
    animation-delay: calc(var(--i) * 150ms);
  }

  .opening__brand {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translateY(6px);
    animation: rise-in 700ms var(--ease-lab) forwards;
    animation-delay: 1.55s;
  }

  .opening__tagline {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: var(--color-muted);
    opacity: 0;
    transform: translateY(6px);
    animation: rise-in 700ms var(--ease-lab) forwards;
    animation-delay: 2.05s;
  }

  .opening__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    opacity: 0;
    animation: rise-in 500ms var(--ease-lab) forwards;
    animation-delay: 1s;
  }

  .opening__skip:hover,
  .opening__skip:focus-visible {
    color: var(--color-ink);
    text-decoration-color: var(--color-line-strong);
  }

  @keyframes letter-draw {
    0% {
      opacity: 0;
      transform: translateY(0.2em);
      color: transparent;
      -webkit-text-stroke: 1.5px var(--color-accent);
    }
    30% {
      opacity: 1;
      transform: translateY(0);
      color: transparent;
      -webkit-text-stroke: 1.5px var(--color-accent);
    }
    75% {
      opacity: 1;
      transform: translateY(0);
      color: transparent;
      -webkit-text-stroke: 1.5px var(--color-accent);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      color: var(--color-ink);
      -webkit-text-stroke: 0px transparent;
    }
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes opening-exit {
    0%,
    88% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening {
      animation-delay: 0.6s;
    }
  }
</style>

<script>
  const opening = document.getElementById('opening');
  const skip = document.getElementById('opening-skip');

  const finish = () => {
    try {
      sessionStorage.setItem('rl-opening-seen', '1');
    } catch {
      /* private mode / storage unavailable — safe to ignore */
    }
  };

  skip?.addEventListener('click', () => {
    opening?.classList.add('is-skipping');
    finish();
  });

  opening?.addEventListener('animationend', (e) => {
    if (e.target === opening) finish();
  });
</script>
