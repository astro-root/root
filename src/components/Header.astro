---
import type { Settings } from '@/lib/defaults';
interface Props { settings: Settings; path: string }
const { settings, path } = Astro.props;
const { site, nav } = settings;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header">
  <div class="shell site-header__bar">
    <a href="/" class="brand" aria-label={`${site.name} ホーム`}>
      <img src={site.logo} alt="" width="32" height="32" />
      <span>{site.name}</span>
      <small>{site.nameEn}</small>
    </a>

    <nav class="site-nav" aria-label="メイン">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener noreferrer' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" id="search-open" aria-haspopup="dialog" aria-label="サイト内検索を開く">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>検索</span><kbd>/</kbd>
      </button>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="テーマを切り替える">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
      </button>
      <button type="button" class="icon-btn nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobile-menu" aria-label="モバイルメニュー" hidden>
  <ul>
    {nav.map((n) => (
      <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}<span aria-hidden="true">→</span></a></li>
    ))}
  </ul>
</nav>

<dialog class="search-dialog" id="search-dialog" aria-label="サイト内検索">
  <form id="search-form" action="/search" method="get" role="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" name="q" id="search-input" placeholder="プロジェクト・ブログ・ページを検索" autocomplete="off" enterkeyhint="search" aria-controls="search-results" aria-label="検索キーワード" maxlength="100" />
    <button type="button" class="icon-btn" id="search-close" aria-label="閉じる">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </form>
  <div class="search-results" id="search-results" role="listbox" aria-label="検索結果"></div>
  <p class="sr-only" id="search-status" role="status" aria-live="polite"></p>
  <div class="search-foot"><span>↑↓ 選択</span><span>Enter 開く</span><span>Esc 閉じる</span></div>
</dialog>
