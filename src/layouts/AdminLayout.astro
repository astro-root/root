---
import '@/styles/global.css';
import '@/styles/admin.css';

interface Props {
  title: string;
  active?: 'dashboard' | 'projects' | 'blog' | 'about' | 'settings';
}

const { title, active } = Astro.props;

const nav = [
  { key: 'dashboard', href: '/admin', label: 'Dashboard' },
  { key: 'projects', href: '/admin/projects', label: 'Projects' },
  { key: 'blog', href: '/admin/blog', label: 'Blog' },
  { key: 'about', href: '/admin/about', label: 'About' },
  { key: 'settings', href: '/admin/settings', label: 'Settings' }
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Admin — Root's Laboratory</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin">
    <div class="admin__shell">
      <aside class="admin__sidebar">
        <a href="/admin" class="admin__mark">ROOT'S<br />LABORATORY</a>
        <p class="admin__tag eyebrow">Admin</p>
        <nav aria-label="Admin">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="admin__sidebar-foot">
          <a href="/" target="_blank" rel="noreferrer" class="admin__view-site">サイトを見る ↗</a>
          <button id="admin-logout" type="button" class="admin__logout">Log out</button>
        </div>
      </aside>

      <main class="admin__main">
        <slot />
      </main>
    </div>

    <script>
      import { getAuthClient, firebaseSignOut, isFirebaseConfigured } from '@/lib/firebase-client';

      const logoutBtn = document.getElementById('admin-logout');
      logoutBtn?.addEventListener('click', async () => {
        if (!isFirebaseConfigured) return;
        await firebaseSignOut(getAuthClient());
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>

<style is:global>
  .admin {
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    min-height: 100vh;
  }

  .admin__shell {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
  }

  .admin__sidebar {
    border-right: 1px solid var(--color-line);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .admin__mark {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    line-height: 1.35;
    text-decoration: none;
    color: var(--color-ink);
  }

  .admin__tag {
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  .admin__sidebar nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .admin__sidebar nav a {
    display: block;
    padding: 0.55rem 0.6rem;
    border-radius: 3px;
    text-decoration: none;
    font-size: var(--fs-00);
    color: var(--color-ink-soft);
  }

  .admin__sidebar nav a:hover {
    background: var(--color-bg-panel);
    color: var(--color-ink);
  }

  .admin__sidebar nav a[aria-current='page'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
  }

  .admin__sidebar-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .admin__view-site {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    text-decoration: none;
  }

  .admin__view-site:hover {
    color: var(--color-accent);
  }

  .admin__logout {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
    text-align: left;
    cursor: pointer;
  }

  .admin__logout:hover {
    color: var(--color-ink);
  }

  .admin__main {
    padding: clamp(1.5rem, 3vw, 3rem);
    max-width: 980px;
  }

  @media (max-width: 800px) {
    .admin__shell {
      grid-template-columns: 1fr;
    }
    .admin__sidebar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--color-line);
    }
    .admin__sidebar nav ul {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .admin__sidebar-foot {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

</style>
