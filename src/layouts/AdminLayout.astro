---
import '@/styles/global.css';
import '@/styles/admin.css';
import { getSettings } from '@/lib/content';

export interface Props { title: string; active: string; subtitle?: string }
const { title, active, subtitle } = Astro.props;
const me = Astro.locals.admin!;
const db = Astro.locals.db;
const [settings, unread] = await Promise.all([
  getSettings(db),
  db.prepare("SELECT COUNT(*) AS n FROM contacts WHERE status = 'new'").first<{ n: number }>()
]);
const groups = [
  { h: '概要', items: [{ id: 'dashboard', href: '/admin', label: 'ダッシュボード' }] },
  { h: 'コンテンツ', items: [
    { id: 'projects', href: '/admin/projects', label: 'プロジェクト' },
    { id: 'blog', href: '/admin/blog', label: 'ブログ' },
    { id: 'profile', href: '/admin/profile', label: 'プロフィール' },
    { id: 'home', href: '/admin/home', label: 'トップページ' },
    { id: 'legal', href: '/admin/legal', label: '利用規約・ポリシー' },
    { id: 'media', href: '/admin/media', label: 'メディア' }
  ] },
  { h: '受信', items: [{ id: 'contacts', href: '/admin/contacts', label: '問い合わせ', badge: unread?.n ?? 0 }] },
  { h: 'サイト設定', items: [
    { id: 'site', href: '/admin/site', label: '基本・ナビ・SEO' },
    { id: 'display', href: '/admin/display', label: '表示・アニメーション' },
    { id: 'account', href: '/admin/account', label: 'アカウント' }
  ] }
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="csrf-token" content={me.csrf} />
    <title>{title} — 管理 | {settings.site.name}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () { var d = document.documentElement; try { var t = localStorage.getItem('theme'); if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; d.setAttribute('data-theme', t); } catch (e) { d.setAttribute('data-theme', 'dark'); } })();
    </script>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="adm-top">
      <a href="/admin" class="brand"><img src={settings.site.logo} alt="" width="28" height="28" /><span>管理</span></a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="テーマを切り替える">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
      </button>
      <button type="button" class="icon-btn" id="adm-toggle" aria-expanded="false" aria-controls="adm-side" aria-label="メニューを開く">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
    <div class="adm">
      <aside class="adm-side" id="adm-side">
        <a href="/admin" class="brand"><img src={settings.site.logo} alt="" width="28" height="28" /><span>{settings.site.name}<br /><small style="display:block;font-family:var(--font-mono);font-weight:400;font-size:.68rem;color:var(--muted)">管理画面</small></span></a>
        <nav class="adm-nav" aria-label="管理メニュー">
          {groups.map((g) => (<>
            <h2>{g.h}</h2>
            {g.items.map((i) => <a href={i.href} aria-current={active === i.id ? 'page' : undefined}>{i.label}{'badge' in i && (i as any).badge > 0 && <span class="badge" aria-label={`未対応 ${(i as any).badge} 件`}>{(i as any).badge}</span>}</a>)}
          </>))}
        </nav>
        <div class="adm-side__foot">
          <a href="/" target="_blank" rel="noopener">サイトを見る ↗</a>
          <span style="overflow-wrap:anywhere">{me.email}</span>
          <button type="button" class="btn btn--sm" id="logout-btn">ログアウト</button>
        </div>
      </aside>
      <div class="adm-scrim" id="adm-scrim" hidden></div>
      <main class="adm-main" id="main" style="padding-top:clamp(1rem,3vw,2.25rem);min-height:0">
        <div class="adm-head">
          <div><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}</div>
          <div class="adm-actions"><slot name="actions" /></div>
        </div>
        <slot />
      </main>
    </div>
    <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
    <script>
      import '@/scripts/admin';
    </script>
  </body>
</html>
