---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getSettings } from '@/lib/content';

export interface Props {
  title?: string;            // 空ならサイト名のみ
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | null;
  intro?: boolean;           // トップのオープニング演出
}

const settings = await getSettings(Astro.locals.db);
const { site, seo, display } = settings;
const { title = '', description = site.description, ogImage, type = 'website', noindex = false, publishedTime, jsonLd = null, intro = false } = Astro.props;

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const abs = (p: string) => (/^https?:\/\//.test(p) ? p : new URL(p, Astro.site ?? Astro.url).toString());
const ogImageUrl = abs(ogImage || seo.ogImage);
const robots = noindex || seo.noindex ? 'noindex, nofollow' : 'index, follow';
const meteors = display.meteors.enabled ? display.meteors.frequency : '';
const useIntro = intro && display.opening;
---

<!doctype html>
<html lang="ja" data-reveal={display.reveal ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0f1e" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {seo.structuredData && jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <!-- 初回描画前にテーマ・演出クラスを確定させ、ちらつきとレイアウトシフトを防ぐ -->
    <script is:inline define:vars={{ useIntro }}>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.setAttribute('data-theme', t);
        } catch (e) { d.setAttribute('data-theme', 'dark'); }
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && d.getAttribute('data-reveal') === '1') d.classList.add('reveal-on');
        try {
          if (useIntro && !reduce && !sessionStorage.getItem('intro')) d.classList.add('intro-on');
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-meteors={meteors || undefined}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    {
      useIntro && (
        <div class="intro" id="intro" aria-hidden="true">
          <div class="intro__inner">
            <img src={site.logo} alt="" width="84" height="84" />
            <p>{site.name}</p>
          </div>
        </div>
      )
    }
    <Header settings={settings} path={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer settings={settings} />
    <script>
      import '@/scripts/ui';
    </script>
  </body>
</html>
