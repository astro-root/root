---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getAbout } from '@/lib/content';

const about = await getAbout();

const facts = [
  { label: 'Based in', value: about.based },
  { label: 'Status', value: about.status },
  { label: 'Currently', value: about.currently }
];
---

<Layout
  title="About"
  description="Root's Laboratory を運営するRootについて。天文・物理・科学とソフトウェア開発への関心と、このサイトの位置づけ。"
>
  <section class="page-head">
    <CosmicField variant="quiet" />
    <div class="wrap page-head__inner">
      <p class="eyebrow">About</p>
      <h1>Root</h1>
    </div>
  </section>

  <section class="facts wrap" aria-label="Profile">
    <dl>
      {
        facts.map((f) => (
          <div class="facts__row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="body wrap prose" set:html={about.bodyHtml} />
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7rem, 16vw, 11rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .page-head__inner {
    position: relative;
    z-index: 1;
  }

  .page-head h1 {
    font-size: clamp(3.2rem, 13vw, 7rem);
    margin-top: 1rem;
  }

  .facts {
    padding-block: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .facts dl {
    display: grid;
    gap: 0.75rem;
  }

  .facts__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    font-size: var(--fs-00);
  }

  .facts__row dt {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .body {
    padding-block: var(--section-space);
  }
</style>
