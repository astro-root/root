---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getAbout, getSettings } from '@/lib/content';

const about = await getAbout();
const settings = await getSettings();

const interests = ['Astronomy', 'Physics', 'Software', 'Quiz'];

const links = [
  { label: 'GitHub', href: settings.githubUrl },
  { label: 'X', href: settings.xUrl },
  { label: 'Email', href: `mailto:${settings.contactEmail}` }
];
---

<Layout title="About" description="Rootについて。">
  <section class="wrap about">
   <div class="about__inner">
    <h1>Root</h1>
    <p class="about__status">{about.status}</p>

    <ul class="about__interests">
      {interests.map((i) => <li>{i}</li>)}
    </ul>

    <p class="about__based">{about.based}</p>

    <ul class="about__links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    {about.bodyHtml && <div class="about__notes prose" set:html={about.bodyHtml} />}
   </div>
  </section>
</Layout>

<style>
  .about {
    padding-top: clamp(5rem, 10vw, 7rem);
    padding-bottom: var(--section-space);
  }

  .about__inner {
    max-width: 34rem;
  }

  .about h1 {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 600;
  }

  .about__status {
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
    font-size: var(--fs-1);
  }

  .about__interests {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .about__interests li {
    font-size: var(--fs-1);
  }

  .about__based {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-00);
    color: var(--color-muted);
  }

  .about__links {
    margin-top: 1rem;
    display: flex;
    gap: 1.25rem;
  }

  .about__links a {
    font-size: var(--fs-00);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
  }

  .about__links a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .about__notes {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--fs-00);
  }
</style>
