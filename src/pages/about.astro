---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import { getPage, getSettings } from '@/lib/content';
import { renderMarkdown } from '@/lib/markdown';

const db = Astro.locals.db;
const [page, settings] = await Promise.all([getPage(db, 'about'), getSettings(db)]);
if (!page) return new Response(null, { status: 404 });
const m = page.meta as { displayName?: string; status?: string; based?: string; image?: string; imageAlt?: string };
const { html } = renderMarkdown(page.body_md);
const links = [...settings.social, ...(settings.site.contactEmail ? [{ label: 'Email', href: `mailto:${settings.site.contactEmail}` }] : [])];
const jsonLd = { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { '@type': 'Person', name: m.displayName ?? 'Root', description: m.status } };
---

<Layout title={page.title} description={page.description || 'るーとについて。'} jsonLd={jsonLd}>
  <div class="shell page">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{m.displayName ?? 'Root'}</h1>
      {m.status && <p class="lede">{m.status}</p>}
    </header>
    <div class="article" style="grid-template-columns:minmax(0,1fr) 20rem">
      <div class="article__main">
        <div class="prose" set:html={html} />
        {settings.home.interests.length > 0 && (<>
          <h2 style="margin-top:3rem;font-size:var(--fs-3)">関心領域</h2>
          <ul class="interest-grid" style="margin-top:1.25rem">{settings.home.interests.map((i) => <li><h3>{i.label}</h3><p>{i.note}</p></li>)}</ul>
        </>)}
      </div>
      <aside class="article__aside">
        {m.image && <img src={m.image} alt={m.imageAlt ?? ''} style="border-radius:14px;margin-bottom:1.5rem;border:1px solid var(--line)" width="320" height="320" />}
        <dl class="meta-table">
          {m.based && <><dt>Based</dt><dd>{m.based}</dd></>}
        </dl>
        {links.length > 0 && <ul class="taglist" style="margin-top:1.25rem">
          {links.map((l) => <li><a class="btn btn--sm" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{l.label}</a></li>)}
        </ul>}
      </aside>
    </div>
  </div>
</Layout>
