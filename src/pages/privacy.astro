---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import { getPage } from '@/lib/content';
import { renderMarkdown } from '@/lib/markdown';

const page = await getPage(Astro.locals.db, 'privacy');
if (!page) return new Response(null, { status: 404 });
const { html, toc } = renderMarkdown(page.body_md);
const updated = page.updated_at.slice(0, 10);
---
<Layout title={page.title} description={page.description}>
  <div class="shell page">
    <nav aria-label="パンくず" class="breadcrumb"><ol><li><a href="/">ホーム</a></li><li aria-current="page">{page.title}</li></ol></nav>
    <div class="article">
      <article class="article__main">
        <header class="article__head"><h1>{page.title}</h1><p class="muted">最終更新日: <time datetime={updated}>{updated}</time></p></header>
        <div class="prose" set:html={html} />
      </article>
      {toc.length > 0 && <aside class="article__aside"><p class="eyebrow" style="margin-bottom:.75rem">目次</p><nav class="toc" aria-label="目次">{toc.map((t) => <a class={`toc--${t.depth}`} href={`#${t.id}`}>{t.text}</a>)}</nav></aside>}
    </div>
  </div>
</Layout>
