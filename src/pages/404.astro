---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
Astro.response.status = 404;
---
<Layout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex>
  <div class="shell page" style="min-height:55vh;display:grid;align-content:center;gap:1.25rem">
    <p class="eyebrow">404</p>
    <h1 style="font-size:var(--fs-4)">ページが見つかりません</h1>
    <p class="lede">URLが変更されたか、非公開・削除された可能性があります。</p>
    <p style="display:flex;gap:.6rem;flex-wrap:wrap"><a class="btn btn--primary" href="/">ホームへ戻る</a><a class="btn" href="/projects">Projects</a><a class="btn" href="/blog">Blog</a></p>
  </div>
</Layout>
