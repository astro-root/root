---
export const prerender = false;
import '@/styles/global.css';
import '@/styles/admin.css';
import { SESSION_COOKIE, getSessionAdmin } from '@/lib/auth';

// すでにログイン済みなら管理画面へ
const admin = await getSessionAdmin(Astro.locals.db, Astro.cookies.get(SESSION_COOKIE)?.value);
if (admin) return Astro.redirect('/admin');
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>ログイン — 管理 | るーとの研究室</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () { var d = document.documentElement; try { var t = localStorage.getItem('theme'); if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; d.setAttribute('data-theme', t); } catch (e) { d.setAttribute('data-theme', 'dark'); } })();
    </script>
  </head>
  <body class="admin">
    <main class="login" id="main" style="padding-top:1rem">
      <div class="login__card panel">
        <p class="brand" style="margin-bottom:1.25rem"><img src="/apple-touch-icon.png" alt="" width="36" height="36" /><span>るーとの研究室 <small style="display:block;font-family:var(--font-mono);font-weight:400;font-size:.7rem;color:var(--muted)">管理画面</small></span></p>
        <form id="login-form" class="form" novalidate>
          <div id="login-error" class="notice notice--error" role="alert" tabindex="-1" hidden></div>
          <div class="field"><label for="email">メールアドレス</label><input class="input" id="email" name="email" type="email" autocomplete="username" required /></div>
          <div class="field"><label for="password">パスワード</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required /></div>
          <button class="btn btn--primary" type="submit" id="login-btn">ログイン</button>
        </form>
      </div>
    </main>
    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const err = document.getElementById('login-error') as HTMLElement;
      const btn = document.getElementById('login-btn') as HTMLButtonElement;
      let busy = false;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (busy) return;
        const d = new FormData(form);
        if (!d.get('email') || !d.get('password')) { err.textContent = 'メールアドレスとパスワードを入力してください。'; err.hidden = false; err.focus(); return; }
        busy = true; btn.disabled = true; btn.textContent = 'ログイン中…'; err.hidden = true;
        try {
          const res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: d.get('email'), password: d.get('password') }) });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) { location.href = '/admin'; return; }
          err.textContent = data.message ?? 'ログインに失敗しました。'; err.hidden = false; err.focus();
        } catch { err.textContent = '通信エラーが発生しました。'; err.hidden = false; }
        busy = false; btn.disabled = false; btn.textContent = 'ログイン';
      });
    </script>
  </body>
</html>
