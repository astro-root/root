---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listProjects } from '@/lib/content';
import { STATE_LABEL } from '@/lib/defaults';
const all = await listProjects(Astro.locals.db, { all: true });
const state = Astro.url.searchParams.get('state') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const rows = all.filter((p) => (!state || p.state === state) && (!q || (p.title + p.id + p.category).toLowerCase().includes(q)));
---
<AdminLayout title="プロジェクト" active="projects" subtitle={`全 ${all.length} 件`}>
  <Fragment slot="actions"><a class="btn btn--primary btn--sm" href="/admin/projects/edit">＋ 新規作成</a></Fragment>
  <form class="toolbar" method="get" role="search">
    <div class="field"><label for="q">検索</label><input class="input" id="q" name="q" value={q} placeholder="タイトル・スラッグ" /></div>
    <div class="field"><label for="st">公開状態</label><select class="select" id="st" name="state"><option value="">すべて</option>{['published', 'draft', 'private'].map((s) => <option value={s} selected={s === state}>{STATE_LABEL[s]}</option>)}</select></div>
    <button class="btn btn--sm" type="submit">絞り込む</button>
  </form>
  {rows.length === 0 ? <div class="empty">該当するプロジェクトがありません。</div> : (
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>タイトル</th><th>カテゴリ</th><th>状況</th><th>公開</th><th class="num">順</th><th>更新</th><th><span class="sr-only">操作</span></th></tr></thead>
      <tbody>{rows.map((p) => (
        <tr><td><a class="title" href={`/admin/projects/edit?id=${p.id}`}>{p.title}</a><br /><span class="muted mono" style="font-size:.72rem">{p.id}</span>{p.featured && <span class="pill pill--new" style="margin-left:.5rem">注目</span>}</td>
          <td>{p.category}</td><td>{p.status}</td><td><span class={`pill pill--${p.state}`}>{STATE_LABEL[p.state]}</span></td><td class="num">{p.sort_order}</td><td class="mono">{p.updated_at.slice(0, 10)}</td>
          <td style="white-space:nowrap"><a class="btn btn--sm" href={`/admin/projects/edit?id=${p.id}`}>編集</a>{p.state === 'published' && <a class="btn btn--sm" href={`/projects/${p.id}`} target="_blank" rel="noopener" style="margin-left:.3rem">表示</a>}</td></tr>
      ))}</tbody></table></div>)}
</AdminLayout>
