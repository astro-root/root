---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import AField from '@/components/AField.astro';
import SaveBar from '@/components/SaveBar.astro';
import { getProject, listProjects } from '@/lib/content';
import { PROJECT_STATUSES, STATE_LABEL } from '@/lib/defaults';
const db = Astro.locals.db;
const id = Astro.url.searchParams.get('id');
const p = id ? await getProject(db, id, { all: true }) : null;
if (id && !p) return Astro.redirect('/admin/projects');
const cats = [...new Set((await listProjects(db, { all: true })).map((x) => x.category).filter(Boolean))];
const isNew = !p;
const v = p ?? { id: '', title: '', summary: '', body_md: '', category: '', status: 'Active', year: String(new Date().getFullYear()), technology: [] as string[], url: '', github: '', thumbnail: '', thumbnail_alt: '', featured: false, sort_order: 50, state: 'draft', published_at: null as string | null };
---
<AdminLayout title={isNew ? 'プロジェクトの新規作成' : `編集: ${v.title}`} active="projects">
  <Fragment slot="actions">
    <a class="btn btn--sm" href="/admin/projects">一覧へ</a>
    {!isNew && v.state === 'published' && <a class="btn btn--sm" href={`/projects/${v.id}`} target="_blank" rel="noopener">公開ページ ↗</a>}
    {!isNew && <button type="button" class="btn btn--sm btn--danger" data-delete={`/api/admin/projects?id=${v.id}`} data-confirm={`「${v.title}」を削除します。元に戻せません。よろしいですか？`} data-after="/admin/projects">削除</button>}
  </Fragment>
  <form data-admin-form data-endpoint="/api/admin/projects" data-after="/admin/projects/edit?id=" data-after-field="id">
    <input type="hidden" name="original" value={p?.id ?? ''} />
    <div class="edit-layout">
      <div class="panel"><div class="grid">
        <AField name="title" label="タイトル" value={v.title} required maxlength={120} />
        <AField name="summary" label="概要（一覧・検索・meta description に使用）" as="textarea" rows={3} value={v.summary} maxlength={300} />
        <AField name="body_md" label="本文（Markdown）" as="textarea" md rows={16} value={v.body_md} />
      </div></div>
      <aside>
        <div class="panel"><h2>公開設定</h2><div class="grid" style="margin-top:.75rem">
          <AField name="state" label="公開状態" as="select" value={v.state} options={['draft', 'published', 'private'].map((s) => ({ value: s, label: STATE_LABEL[s] }))} hint="公開以外は公開サイト・検索・サイトマップに出ません。" />
          <AField name="published_at" label="公開日" type="date" value={v.published_at ? v.published_at.slice(0, 10) : ''} hint="未来の日付にすると、その日まで公開されません。空欄なら保存時刻。" />
          <AField name="featured" type="checkbox" label="トップページで注目表示する" value={v.featured} />
          <AField name="sort_order" label="表示順（小さいほど先頭）" type="number" min={0} max={9999} value={v.sort_order} />
        </div></div>
        <div class="panel"><h2>分類</h2><div class="grid" style="margin-top:.75rem">
          <AField name="id" label="スラッグ（URL）" value={v.id} required maxlength={80} hint="英小文字・数字・ハイフン。/projects/○○ になります。" />
          <div class="field"><label for="f-category">カテゴリ</label><input class="input" id="f-category" name="category" value={v.category} maxlength={40} list="cats" /><datalist id="cats">{cats.map((c) => <option value={c} />)}</datalist><p class="field-error"></p></div>
          <AField name="status" label="開発状況" as="select" value={v.status} options={PROJECT_STATUSES.map((s) => ({ value: s, label: s }))} />
          <AField name="year" label="年（例: 2024– / 2025）" value={v.year} maxlength={20} />
          <AField name="technology" label="技術スタック（カンマ区切り）" value={v.technology.join(', ')} hint="例: TypeScript, React, WebSocket" />
        </div></div>
        <div class="panel"><h2>リンク・画像</h2><div class="grid" style="margin-top:.75rem">
          <AField name="url" label="公開サイトURL" type="url" value={v.url ?? ''} placeholder="https://" />
          <AField name="github" label="GitHub URL" type="url" value={v.github ?? ''} placeholder="https://github.com/…" />
          <AField name="thumbnail" label="サムネイル" value={v.thumbnail ?? ''} upload />
          <AField name="thumbnail_alt" label="サムネイルの代替テキスト" value={v.thumbnail_alt} maxlength={200} />
        </div></div>
      </aside>
    </div>
    <SaveBar />
  </form>
</AdminLayout>
