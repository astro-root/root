---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import AField from '@/components/AField.astro';
import SaveBar from '@/components/SaveBar.astro';
import { getPost, listPosts } from '@/lib/content';
import { STATE_LABEL } from '@/lib/defaults';
const db = Astro.locals.db;
const slug = Astro.url.searchParams.get('slug');
const p = slug ? await getPost(db, slug, { all: true }) : null;
if (slug && !p) return Astro.redirect('/admin/blog');
const cats = [...new Set((await listPosts(db, { all: true })).map((x) => x.category).filter(Boolean))];
const isNew = !p;
const v = p ?? { slug: '', title: '', excerpt: '', body_md: '', category: '', tags: [] as string[], thumbnail: '', thumbnail_alt: '', featured: false, state: 'draft', published_at: null as string | null, seo_title: '', seo_description: '' };
---
<AdminLayout title={isNew ? '記事の新規作成' : `編集: ${v.title}`} active="blog">
  <Fragment slot="actions">
    <a class="btn btn--sm" href="/admin/blog">一覧へ</a>
    {!isNew && v.state === 'published' && <a class="btn btn--sm" href={`/blog/${v.slug}`} target="_blank" rel="noopener">公開ページ ↗</a>}
    {!isNew && <button type="button" class="btn btn--sm btn--danger" data-delete={`/api/admin/posts?slug=${v.slug}`} data-confirm={`「${v.title}」を削除します。元に戻せません。よろしいですか？`} data-after="/admin/blog">削除</button>}
  </Fragment>
  <form data-admin-form data-endpoint="/api/admin/posts" data-after="/admin/blog/edit?slug=" data-after-field="slug">
    <input type="hidden" name="original" value={p?.slug ?? ''} />
    <div class="edit-layout">
      <div class="panel"><div class="grid">
        <AField name="title" label="タイトル" value={v.title} required maxlength={150} />
        <AField name="excerpt" label="要約（一覧・meta description の既定値）" as="textarea" rows={3} value={v.excerpt} maxlength={300} />
        <AField name="body_md" label="本文（Markdown）" as="textarea" md rows={22} value={v.body_md} />
      </div></div>
      <aside>
        <div class="panel"><h2>公開設定</h2><div class="grid" style="margin-top:.75rem">
          <AField name="state" label="公開状態" as="select" value={v.state} options={['draft', 'published', 'private'].map((s) => ({ value: s, label: STATE_LABEL[s] }))} hint="公開以外は公開サイト・検索・サイトマップに出ません。" />
          <AField name="published_at" label="公開日" type="date" value={v.published_at ? v.published_at.slice(0, 10) : ''} hint="未来の日付にすると予約公開になります。空欄なら保存時刻。" />
        </div></div>
        <div class="panel"><h2>分類</h2><div class="grid" style="margin-top:.75rem">
          <AField name="slug" label="スラッグ（URL）" value={v.slug} required maxlength={80} hint="英小文字・数字・ハイフン。/blog/○○ になります。" />
          <div class="field"><label for="f-category">カテゴリ</label><input class="input" id="f-category" name="category" value={v.category} maxlength={40} list="cats" /><datalist id="cats">{cats.map((c) => <option value={c} />)}</datalist><p class="field-error"></p></div>
          <AField name="tags" label="タグ（カンマ区切り）" value={v.tags.join(', ')} hint="例: 物理, 光, 覚え書き" />
        </div></div>
        <div class="panel"><h2>アイキャッチ</h2><div class="grid" style="margin-top:.75rem">
          <AField name="thumbnail" label="画像" value={v.thumbnail ?? ''} upload hint="OGP画像にも使われます（推奨 1200×630）。" />
          <AField name="thumbnail_alt" label="代替テキスト" value={v.thumbnail_alt} maxlength={200} />
        </div></div>
        <div class="panel"><h2>SEO</h2><div class="grid" style="margin-top:.75rem">
          <AField name="seo_title" label="タイトル（空欄で記事タイトル）" value={v.seo_title} maxlength={120} />
          <AField name="seo_description" label="meta description（空欄で要約）" as="textarea" rows={3} value={v.seo_description} maxlength={200} />
        </div></div>
      </aside>
    </div>
    <SaveBar />
  </form>
</AdminLayout>
