---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listPosts } from '@/lib/content';
import { STATE_LABEL } from '@/lib/defaults';
const all = await listPosts(Astro.locals.db, { all: true });
const state = Astro.url.searchParams.get('state') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const rows = all.filter((p) => (!state || p.state === state) && (!q || (p.title + p.slug + p.category + p.tags.join(' ')).toLowerCase().includes(q)));
---
<AdminLayout title="ブログ" active="blog" subtitle={`全 ${all.length} 件`}>
  <Fragment slot="actions"><a class="btn btn--primary btn--sm" href="/admin/blog/edit">＋ 記事を書く</a></Fragment>
  <form class="toolbar" method="get" role="search">
    <div class="field"><label for="q">検索</label><input class="input" id="q" name="q" value={q} placeholder="タイトル・スラッグ・タグ" /></div>
    <div class="field"><label for="st">公開状態</label><select class="select" id="st" name="state"><option value="">すべて</option>{['published', 'draft', 'private'].map((s) => <option value={s} selected={s === state}>{STATE_LABEL[s]}</option>)}</select></div>
    <button class="btn btn--sm" type="submit">絞り込む</button>
  </form>
  {rows.length === 0 ? <div class="empty">該当する記事がありません。</div> : (
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>タイトル</th><th>カテゴリ</th><th>公開</th><th>公開日</th><th>更新</th><th><span class="sr-only">操作</span></th></tr></thead>
      <tbody>{rows.map((p) => (
        <tr><td><a class="title" href={`/admin/blog/edit?slug=${p.slug}`}>{p.title}</a><br /><span class="muted mono" style="font-size:.72rem">{p.slug}</span></td>
          <td>{p.category}</td><td><span class={`pill pill--${p.state}`}>{STATE_LABEL[p.state]}</span></td><td class="mono">{(p.published_at ?? '—').slice(0, 10)}</td><td class="mono">{p.updated_at.slice(0, 10)}</td>
          <td style="white-space:nowrap"><a class="btn btn--sm" href={`/admin/blog/edit?slug=${p.slug}`}>編集</a>{p.state === 'published' && <a class="btn btn--sm" href={`/blog/${p.slug}`} target="_blank" rel="noopener" style="margin-left:.3rem">表示</a>}</td></tr>
      ))}</tbody></table></div>)}
</AdminLayout>
