---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="About" active="about">
  <div class="admin-heading">
    <h1>About</h1>
  </div>

  <p id="loading" class="loading-note">読み込み中…</p>
  <div id="status-msg-holder"></div>

  <form id="about-form" class="panel" hidden novalidate>
    <div class="field-row">
      <div class="field">
        <label for="based">Based in</label>
        <input id="based" type="text" />
      </div>
      <div class="field">
        <label for="status">Status</label>
        <input id="status" type="text" />
      </div>
      <div class="field">
        <label for="currently">Currently</label>
        <input id="currently" type="text" />
      </div>
    </div>

    <div class="field">
      <label for="body">本文（Markdown） *</label>
      <textarea id="body" required rows="22"></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" id="submit-btn">保存する</button>
    </div>
  </form>
</AdminLayout>

<script>
  import { requireAdmin, getDb, doc, getDoc, setDoc } from '@/lib/firebase-client';

  await requireAdmin();
  const db = getDb();

  const form = document.getElementById('about-form') as HTMLFormElement;

  function field(fid: string) {
    return document.getElementById(fid) as HTMLInputElement | HTMLTextAreaElement;
  }

  function showMsg(msg: string, ok = true) {
    document.getElementById('status-msg-holder')!.innerHTML =
      `<p class="status-msg ${ok ? 'ok' : 'err'}">${msg}</p>`;
  }

  const snap = await getDoc(doc(db, 'about', 'main'));
  if (snap.exists()) {
    const d = snap.data() as any;
    (field('based') as HTMLInputElement).value = d.based ?? 'Japan';
    (field('status') as HTMLInputElement).value = d.status ?? '';
    (field('currently') as HTMLInputElement).value = d.currently ?? '';
    (field('body') as HTMLTextAreaElement).value = d.bodyMarkdown ?? '';
  } else {
    (field('based') as HTMLInputElement).value = 'Japan';
  }

  document.getElementById('loading')!.setAttribute('hidden', '');
  form.hidden = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = '保存中…';

    const payload = {
      based: (field('based') as HTMLInputElement).value.trim(),
      status: (field('status') as HTMLInputElement).value.trim(),
      currently: (field('currently') as HTMLInputElement).value.trim(),
      bodyMarkdown: (field('body') as HTMLTextAreaElement).value,
      updated: new Date().toISOString()
    };

    try {
      await setDoc(doc(db, 'about', 'main'), payload, { merge: true });
      showMsg('保存しました。サイトに反映されています。');
    } catch (err: any) {
      showMsg(`保存に失敗しました: ${err.message ?? err}`, false);
    }
    submitBtn.disabled = false;
    submitBtn.textContent = '保存する';
  });
</script>

<style>
  .form-actions {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>
