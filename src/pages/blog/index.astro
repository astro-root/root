---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import NoteRow from '@/components/NoteRow.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getPosts } from '@/lib/content';

const posts = await getPosts();
const categories = [...new Set(posts.map((p) => p.category))];
---

<Layout
  title="Blog"
  description="観測記録、物理の考察、制作の過程など、Rootが書きためているノート。"
>
  <section class="page-head">
    <CosmicField variant="quiet" />
    <div class="wrap page-head__inner">
      <p class="eyebrow">Laboratory Notes</p>
      <h1>Notes</h1>
      <p class="page-head__lede">
        観測の記録、物理の考察、制作の過程。まとまった記事というより、研究ノートに近い、気づいたことの記録。
      </p>
      {
        categories.length > 0 && (
          <p class="page-head__categories">
            {categories.map((c) => (
              <span>{c}</span>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <section class="list wrap">
    {
      posts.length > 0 ? (
        posts.map((post) => <NoteRow post={post} />)
      ) : (
        <p class="list__empty">まだ記事がありません。近いうちに書きます。</p>
      )
    }
  </section>
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7rem, 16vw, 11rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .page-head__inner {
    position: relative;
    z-index: 1;
  }

  .page-head h1 {
    font-size: clamp(3.2rem, 13vw, 7rem);
    margin-top: 1rem;
  }

  .page-head__lede {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--color-ink-soft);
    font-size: var(--fs-1);
  }

  .page-head__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .list {
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: var(--section-space);
  }

  .list :global(.note:last-child) {
    border-bottom: 1px solid var(--color-line);
  }

  .list__empty {
    padding-block: 3rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }
</style>
