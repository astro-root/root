---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import ProjectEntry from '@/components/ProjectEntry.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
---

<Layout
  title="Projects"
  description="Rootが制作しているWebサービス・ソフトウェア・実験的なプロジェクトの一覧。"
>
  <section class="page-head">
    <CosmicField variant="quiet" />
    <div class="wrap page-head__inner">
      <p class="eyebrow">Projects</p>
      <h1>作っているもの</h1>
      <p class="page-head__lede">
        完成しているものも、まだ途中のものも並んでいます。気になるものから見てください。
      </p>
    </div>
  </section>

  <section class="catalog wrap">
    <div class="project-grid">
      {projects.map((project) => <ProjectEntry project={project} variant="full" />)}
    </div>
  </section>
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7rem, 16vw, 11rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .page-head__inner {
    position: relative;
    z-index: 1;
  }

  .page-head h1 {
    font-size: clamp(3.2rem, 13vw, 7rem);
    margin-top: 1rem;
  }

  .page-head__lede {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--color-ink-soft);
    font-size: var(--fs-1);
  }

  .catalog {
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: var(--section-space);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .catalog :global(.entry:last-child) {
    border-bottom: 1px solid var(--color-line);
  }
</style>
