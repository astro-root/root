---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import ProjectEntry from '@/components/ProjectEntry.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();

function yearOf(y: string): string {
  const m = y.match(/\d{4}/);
  return m ? m[0] : y;
}

const groups = new Map<string, typeof projects>();
for (const p of projects) {
  const y = yearOf(p.year);
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const sortedYears = [...groups.keys()].sort((a, b) => b.localeCompare(a));
---

<Layout
  title="Projects"
  description="Rootが作っているWebサービス・ソフトウェア・実験的なプロジェクトの一覧。"
>
  <section class="wrap page-head">
    <h1>Projects</h1>
  </section>

  <section class="wrap catalog">
    {
      sortedYears.map((year) => (
        <div class="year-group">
          <p class="year-group__label">{year}</p>
          <div class="year-group__list">
            {groups.get(year)!.map((project) => <ProjectEntry project={project} />)}
          </div>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  .page-head {
    padding-top: clamp(5rem, 10vw, 7rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
  }

  .catalog {
    padding-bottom: var(--section-space);
  }

  .year-group {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .year-group__label {
    font-family: var(--font-mono);
    font-size: var(--fs-00);
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .year-group__list :global(.row:last-child) {
    border-bottom: 1px solid var(--color-line);
  }
</style>
