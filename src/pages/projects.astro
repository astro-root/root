---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import ProjectEntry from '@/components/ProjectEntry.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
---

<Layout
  title="Projects"
  description="Rootが作っているWebサービス・ソフトウェア・実験的なプロジェクトの一覧。"
>
  <section class="wrap page-head">
    <h1>Projects</h1>
    <p class="page-head__lede">完成しているものも、まだ途中のものも並んでいます。</p>
  </section>

  <section class="wrap catalog">
    <div class="project-grid">
      {projects.map((project) => <ProjectEntry project={project} />)}
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-top: clamp(5rem, 10vw, 7rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
  }

  .page-head__lede {
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
  }

  .catalog {
    padding-bottom: var(--section-space);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
</style>
