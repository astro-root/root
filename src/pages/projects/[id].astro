---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import { getProject, getSettings } from '@/lib/content';
import { renderMarkdown } from '@/lib/markdown';

const { id } = Astro.params;
const db = Astro.locals.db;
const project = id ? await getProject(db, id) : null;
if (!project) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
const { html, toc } = renderMarkdown(project.body_md);
const settings = await getSettings(db);
const jsonLd = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.title, description: project.summary, url: new URL(`/projects/${project.id}`, Astro.site).toString(), keywords: project.technology.join(', '), author: { '@type': 'Person', name: 'Root' }, inLanguage: 'ja' };
---

<Layout title={project.title} description={project.summary || settings.site.description} ogImage={project.thumbnail ?? undefined} jsonLd={jsonLd}>
  <div class="shell page">
    <nav aria-label="パンくず" class="breadcrumb"><ol><li><a href="/">ホーム</a></li><li><a href="/projects">Projects</a></li><li aria-current="page">{project.title}</li></ol></nav>
    <div class="article">
      <article class="article__main">
        <header class="article__head">
          <p class="eyebrow">{project.category} · <span class="status" data-s={project.status}>{project.status}</span></p>
          <h1>{project.title}</h1>
          {project.summary && <p class="lede">{project.summary}</p>}
          {project.technology.length > 0 && <ul class="taglist">{project.technology.map((t) => <li><a class="tag" href={`/projects?tech=${encodeURIComponent(t)}`}>{t}</a></li>)}</ul>}
          {(project.url || project.github) && (
            <div style="display:flex;gap:0.6rem;flex-wrap:wrap">
              {project.url && <a class="btn btn--primary" href={project.url} target="_blank" rel="noopener noreferrer">サイトを開く ↗</a>}
              {project.github && <a class="btn" href={project.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
            </div>
          )}
        </header>
        {project.thumbnail && <img src={project.thumbnail} alt={project.thumbnail_alt} style="border-radius:14px;margin-bottom:2rem;border:1px solid var(--line)" width="1280" height="720" />}
        <div class="prose" set:html={html} />
      </article>
      <aside class="article__aside" aria-label="プロジェクト情報">
        <dl class="meta-table">
          <dt>Year</dt><dd>{project.year || '—'}</dd>
          <dt>Status</dt><dd>{project.status}</dd>
          <dt>Category</dt><dd>{project.category || '—'}</dd>
        </dl>
        {toc.length > 0 && (<>
          <p class="eyebrow" style="margin:1.75rem 0 0.75rem">目次</p>
          <nav class="toc" aria-label="目次">{toc.map((t) => <a class={`toc--${t.depth}`} href={`#${t.id}`}>{t.text}</a>)}</nav>
        </>)}
      </aside>
    </div>
  </div>
</Layout>
