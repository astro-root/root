---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getSettings } from '@/lib/content';

const settings = await getSettings();

const links = [
  {
    label: 'Email',
    value: settings.contactEmail,
    href: `mailto:${settings.contactEmail}`
  },
  { label: 'GitHub', value: settings.githubUrl.replace(/^https?:\/\//, ''), href: settings.githubUrl },
  { label: 'X', value: settings.xUrl.replace(/^https?:\/\//, ''), href: settings.xUrl }
];
---

<Layout
  title="Contact"
  description="Root's Laboratory への連絡先。プロジェクトのご相談やご質問はメールでお願いします。"
>
  <section class="page-head">
    <CosmicField variant="quiet" />
    <div class="wrap page-head__inner">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk</h1>
      <p class="page-head__lede">
        プロジェクトのご相談、ご質問、その他のご連絡はメールでお願いします。できるだけ早く返信します。
      </p>
    </div>
  </section>

  <section class="links wrap">
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="links__label eyebrow">{l.label}</span>
              <span class="links__value">{l.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7rem, 16vw, 11rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .page-head__inner {
    position: relative;
    z-index: 1;
  }

  .page-head h1 {
    font-size: clamp(3.2rem, 13vw, 7rem);
    margin-top: 1rem;
  }

  .page-head__lede {
    margin-top: 1.5rem;
    max-width: 48ch;
    color: var(--color-ink-soft);
    font-size: var(--fs-1);
  }

  .links {
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: var(--section-space);
    border-top: 1px solid var(--color-line);
  }

  .links ul {
    display: flex;
    flex-direction: column;
  }

  .links li {
    border-bottom: 1px solid var(--color-line);
  }

  .links a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    text-decoration: none;
  }

  .links__value {
    font-size: clamp(1.5rem, 5vw, 2.75rem);
    letter-spacing: -0.01em;
    transition: color var(--dur-fast) var(--ease-lab);
  }

  .links a:hover .links__value,
  .links a:focus-visible .links__value {
    color: var(--color-accent);
  }
</style>
