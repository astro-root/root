---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getSettings } from '@/lib/content';

const settings = await getSettings();

const links = [
  {
    label: 'Email',
    value: settings.contactEmail,
    href: `mailto:${settings.contactEmail}`
  },
  { label: 'GitHub', value: settings.githubUrl.replace(/^https?:\/\//, ''), href: settings.githubUrl },
  { label: 'X', value: settings.xUrl.replace(/^https?:\/\//, ''), href: settings.xUrl }
];
---

<Layout title="Contact" description="連絡先。">
  <section class="wrap page-head">
    <h1>Contact</h1>
  </section>

  <section class="links wrap">
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="links__label eyebrow">{l.label}</span>
              <span class="links__value">{l.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .page-head {
    padding-top: clamp(5rem, 10vw, 7rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
  }

  .links {
    padding-bottom: var(--section-space);
    border-top: 1px solid var(--color-line);
  }

  .links ul {
    display: flex;
    flex-direction: column;
  }

  .links li {
    border-bottom: 1px solid var(--color-line);
  }

  .links a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    text-decoration: none;
  }

  .links__value {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  .links a:hover .links__value {
    text-decoration: underline;
  }
</style>
