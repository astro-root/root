---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import Opening from '@/components/Opening.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getSettings } from '@/lib/content';

const settings = await getSettings();

const interests = ['Astronomy', 'Physics', 'Software', 'Quiz'];

const links = [
  { n: '01', href: '/projects', label: 'Projects' },
  { n: '02', href: '/blog', label: 'Notes' },
  { n: '03', href: '/about', label: 'About' },
  { n: '04', href: '/contact', label: 'Contact' }
];
---

<Layout title="Root's Laboratory" description={settings.siteDescription}>
  <Opening />

  <section class="hero">
    <CosmicField variant="quiet" />
    <div class="wrap hero__inner">
      <h1 class="hero__word">Root</h1>
      <p class="hero__interests">{interests.join(' / ')}</p>

      <ul class="hero__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="hero__links-n">{l.n}</span>
                <span class="hero__links-label">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero__word {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero__interests {
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--fs-00);
    color: var(--color-muted);
  }

  .hero__links {
    margin-top: clamp(3rem, 8vw, 5rem);
    display: flex;
    flex-direction: column;
  }

  .hero__links li {
    border-top: 1px solid var(--color-line);
  }

  .hero__links li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .hero__links a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1rem;
    text-decoration: none;
    width: fit-content;
  }

  .hero__links-n {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-accent);
  }

  .hero__links-label {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    position: relative;
  }

  .hero__links-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 1px;
    background: var(--color-ink);
    transition: right var(--dur-med) var(--ease-lab);
  }

  .hero__links a:hover .hero__links-label::after,
  .hero__links a:focus-visible .hero__links-label::after {
    right: 0;
  }
</style>
