---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import Opening from '@/components/Opening.astro';
import CosmicField from '@/components/CosmicField.astro';
import { getSettings } from '@/lib/content';

const settings = await getSettings();

const interests = ['Astronomy', 'Physics', 'Software', 'Quiz'];

const links = [
  { n: '01', href: '/projects', label: 'Projects', note: '作っているもの' },
  { n: '02', href: '/blog', label: 'Notes', note: '観測・考察の記録' },
  { n: '03', href: '/about', label: 'About', note: 'Rootについて' },
  { n: '04', href: '/contact', label: 'Contact', note: '連絡先' }
];
---

<Layout title="Root's Laboratory" description={settings.siteDescription}>
  <Opening />

  <section class="hero">
    <CosmicField variant="quiet" />
    <div class="wrap hero__inner">
      <h1 class="hero__word">Root</h1>
      <p class="hero__interests">{interests.join(' / ')}</p>

      <ul class="hero__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="hero__card">
                <span class="hero__card-n">{l.n}</span>
                <span class="hero__card-label">{l.label}</span>
                <span class="hero__card-note">{l.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero__word {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero__interests {
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--fs-00);
    color: var(--color-muted);
  }

  .hero__links {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 16rem));
    gap: 1rem;
  }

  .hero__card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-lab), border-color var(--dur-fast) var(--ease-lab),
      box-shadow var(--dur-fast) var(--ease-lab);
  }

  .hero__card:hover,
  .hero__card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
    box-shadow: 0 1px 2px rgba(17, 18, 20, 0.04), 0 16px 32px -14px rgba(17, 18, 20, 0.22);
  }

  .hero__card-n {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-accent);
  }

  .hero__card-label {
    margin-top: 0.6rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .hero__card-note {
    margin-top: 0.3rem;
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  @media (max-width: 520px) {
    .hero__links {
      grid-template-columns: 1fr;
    }
  }
</style>
