---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostRow from '@/components/PostRow.astro';
import { getSettings, listProjects, listPosts } from '@/lib/content';

const db = Astro.locals.db;
const settings = await getSettings(db);
const { home, site, nav } = settings;
const [allProjects, posts] = await Promise.all([listProjects(db), listPosts(db, { limit: 4 })]);
const featured = allProjects.filter((p) => p.featured);
const projects = (featured.length ? featured : allProjects).slice(0, 6);
const sections = home.sections.filter((s) => s.enabled);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, alternateName: site.nameEn, url: Astro.site?.toString(), description: site.description, inLanguage: 'ja' };
---

<Layout description={site.description} intro jsonLd={jsonLd}>
  {sections.map((s) => {
    if (s.id === 'hero') return (
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero__grid">
          <div>
            <p class="eyebrow reveal">{site.tagline}</p>
            <h1 id="hero-title" class="reveal" style="--d:80ms">{home.heroTitle}</h1>
            <p class="lede reveal" style="--d:160ms">{home.heroLede}</p>
            {s.body && <p class="muted reveal" style="--d:200ms;margin-top:1rem">{s.body}</p>}
            {home.buttons.length > 0 && (
              <div class="hero__actions reveal" style="--d:240ms">
                {home.buttons.map((b) => <a class:list={['btn', { 'btn--primary': b.primary }]} href={b.href}>{b.label}</a>)}
              </div>
            )}
          </div>
          <div class="hero__mark reveal" style="--d:200ms">
            <img src={site.logo} alt={site.logoAlt} width="352" height="352" />
          </div>
        </div>
      </section>
    );
    if (s.id === 'interests' && home.interests.length) return (
      <section class="section" aria-labelledby="interests-h"><div class="shell">
        <div class="section__head"><h2 id="interests-h">{s.title}</h2></div>
        {s.body && <p class="lede" style="margin-bottom:1.5rem">{s.body}</p>}
        <ul class="interest-grid">{home.interests.map((i, n) => <li class="reveal" style={`--d:${n * 60}ms`}><h3>{i.label}</h3><p>{i.note}</p></li>)}</ul>
      </div></section>
    );
    if (s.id === 'projects' && projects.length) return (
      <section class="section" aria-labelledby="projects-h"><div class="shell">
        <div class="section__head"><h2 id="projects-h">{s.title}</h2><a class="more-link" href="/projects">すべて見る</a></div>
        {s.body && <p class="lede" style="margin-bottom:1.5rem">{s.body}</p>}
        <div class="project-grid">{projects.map((p, n) => <ProjectCard project={p} delay={n * 60} />)}</div>
      </div></section>
    );
    if (s.id === 'notes' && posts.length) return (
      <section class="section" aria-labelledby="notes-h"><div class="shell">
        <div class="section__head"><h2 id="notes-h">{s.title}</h2><a class="more-link" href="/blog">すべて見る</a></div>
        {s.body && <p class="lede" style="margin-bottom:1.5rem">{s.body}</p>}
        <ul class="post-list">{posts.map((p) => <PostRow post={p} />)}</ul>
      </div></section>
    );
    if (s.id === 'news' && home.news.length) return (
      <section class="section" aria-labelledby="news-h"><div class="shell">
        <div class="section__head"><h2 id="news-h">{s.title}</h2></div>
        <ul class="post-list">
          {home.news.map((n) => (
            <li class="reveal">
              {n.href ? <a class="post-row" href={n.href}><time>{n.date}</time><div><h3>{n.text}</h3></div><span></span></a>
                      : <div class="post-row"><time>{n.date}</time><div><h3>{n.text}</h3></div><span></span></div>}
            </li>
          ))}
        </ul>
      </div></section>
    );
    if (s.id === 'links') return (
      <section class="section" aria-labelledby="links-h"><div class="shell">
        <div class="section__head"><h2 id="links-h">{s.title}</h2></div>
        <ul class="interest-grid">
          {nav.map((n, i) => <li class="reveal" style={`--d:${i * 60}ms`}><h3><a href={n.href}>{n.label}</a></h3></li>)}
        </ul>
      </div></section>
    );
    return null;
  })}
</Layout>
