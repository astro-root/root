---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Opening from '@/components/Opening.astro';
import ProjectEntry from '@/components/ProjectEntry.astro';
import NoteRow from '@/components/NoteRow.astro';
import { interests } from '@/data/interests';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = allProjects.filter((p) => p.data.featured).slice(0, 4);

const notes = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const about = await getEntry('about', 'index');
const { Content: AboutContent } = await render(about);
---

<Layout
  title="Root's Laboratory"
  description="高校生Rootが、天文・物理・科学とソフトウェア開発を横断しながら研究・制作・実験する個人ラボラトリー。"
>
  <Opening />

  <section class="hero">
    <div class="wrap hero__inner">
      <h1 class="hero__title">
        <span>ROOT'S</span>
        <span>LABORATORY</span>
      </h1>
      <p class="hero__tagline">Science. Software. Ideas.</p>
      <p class="hero__lede">
        興味を持ったものを研究し、作り、確かめる。天文・物理・科学と、Web開発・ソフトウェアを横断しながら実験を続ける個人のラボラトリー。
      </p>
      <ul class="hero__tags">
        {interests.map((i) => <li>{i.label}</li>)}
      </ul>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <span></span>
      <p>Scroll</p>
    </div>
  </section>

  <section class="statement wrap">
    <p class="statement__eyebrow eyebrow">Introduction</p>
    <p class="statement__lead">
      A place where I explore, build, and experiment —
      観測して、確かめて、作ってみる。うまくいかないことも含めて、その過程を残す場所。
    </p>
  </section>

  <section class="featured wrap" aria-labelledby="featured-heading">
    <div class="section-head">
      <p class="eyebrow">Selected work</p>
      <h2 id="featured-heading">Featured Projects</h2>
    </div>

    <div class="featured__list">
      {
        featured.map((project, i) => (
          <ProjectEntry project={project} index={i + 1} variant="compact" />
        ))
      }
    </div>

    <a class="section-link" href="/projects">View all projects →</a>
  </section>

  <section class="research" aria-labelledby="research-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Research &amp; Interests</p>
        <h2 id="research-heading">What I keep coming back to</h2>
      </div>

      <ul class="research__grid">
        {
          interests.map((interest) => (
            <li>
              <p class="research__label">{interest.label}</p>
              <p class="research__note">{interest.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="notes wrap" aria-labelledby="notes-heading">
    <div class="section-head">
      <p class="eyebrow">Field notes</p>
      <h2 id="notes-heading">Latest Notes</h2>
    </div>

    <div class="notes__list">
      {notes.map((post) => <NoteRow post={post} />)}
    </div>

    <a class="section-link" href="/blog">Read the blog →</a>
  </section>

  <section class="about-teaser wrap" aria-labelledby="about-heading">
    <div class="section-head">
      <p class="eyebrow">About</p>
      <h2 id="about-heading">Who's behind this</h2>
    </div>
    <div class="about-teaser__content prose">
      <AboutContent />
    </div>
    <a class="section-link" href="/about">More about Root →</a>
  </section>

  <section class="contact-teaser wrap">
    <p class="contact-teaser__text">
      プロジェクトのご相談・お問い合わせは
      <a href="/contact">こちら</a>
      から。
    </p>
  </section>
</Layout>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: 5rem;
  }

  .hero__inner {
    padding-block: 2rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.2rem, 13vw, 9.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.92;
  }

  .hero__tagline {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.6vw, 1.05rem);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .hero__lede {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--color-ink-soft);
    font-size: var(--fs-1);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .hero__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  .hero__tags li:not(:last-child)::after {
    content: '/';
    margin-left: 1.25rem;
    color: var(--color-line-strong);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__scroll span {
    width: 1px;
    height: 2.5rem;
    background: var(--color-line-strong);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: translateY(-100%);
    animation: scroll-line 2.2s var(--ease-lab) infinite;
  }

  .hero__scroll p {
    font-family: var(--font-mono);
    font-size: var(--fs-000);
    color: var(--color-muted);
  }

  @keyframes scroll-line {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll span::after {
      animation: none;
      transform: translateY(0);
    }
  }

  /* ---- Statement --------------------------------------------------- */
  .statement {
    padding-block: clamp(4rem, 12vw, 8rem);
    border-top: 1px solid var(--color-line);
  }

  .statement__eyebrow {
    margin-bottom: 1.5rem;
  }

  .statement__lead {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    line-height: 1.35;
    max-width: 24ch;
    letter-spacing: -0.01em;
  }

  /* ---- Shared section head ------------------------------------------ */
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .section-link {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: var(--fs-00);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) var(--ease-lab), color var(--dur-fast);
  }

  .section-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .featured,
  .notes,
  .about-teaser {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  /* ---- Research (distinct rhythm: raised panel, wrapping grid) ------ */
  .research {
    background: var(--color-bg-raised);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .research__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .research__grid li {
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem) 0;
    border-top: 1px solid var(--color-line);
  }

  .research__label {
    font-size: var(--fs-2);
  }

  .research__note {
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
    max-width: 32ch;
    font-size: var(--fs-00);
  }

  /* ---- About teaser --------------------------------------------------- */
  .about-teaser__content {
    max-width: var(--measure);
  }

  .about-teaser__content :global(h2),
  .about-teaser__content :global(h3) {
    display: none;
  }

  .about-teaser__content :global(p) {
    margin-top: 1rem;
  }

  .about-teaser__content :global(p:first-of-type) {
    margin-top: 0;
    font-size: var(--fs-1);
  }

  /* keep only the opening paragraphs on the home teaser */
  .about-teaser__content :global(p:nth-of-type(n + 3)) {
    display: none;
  }

  /* ---- Contact teaser --------------------------------------------------- */
  .contact-teaser {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--color-line);
  }

  .contact-teaser__text {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
  }

  .contact-teaser__text a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }
</style>
